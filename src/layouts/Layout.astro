---
import '../styles/global.css';
import { colors, site } from '../config/environment';
import { asset } from '../utils/asset';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : `${site.title} · ${site.subtitle}`;

// Convierte { primaryDark: '#...' } en --color-primary-dark: #...;
const toKebab = (s: string) => s.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase());
const cssVars = Object.entries(colors)
  .map(([key, value]) => `--color-${toKebab(key)}: ${value};`)
  .join('\n  ');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content={colors.primaryDark} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <style is:inline set:html={`:root {\n  ${cssVars}\n}`}></style>
  </head>
  <body>
    <slot />
  </body>
</html>
